#!/bin/bash
# accepted vars: MODE (RenPy|RPGM|Ace|Other), GAMEDIR (./game|./www|.), FFMPEG, CONVERT, VAAPI_DEVICE, QUALITY (80), MAX_DIM (720), THREADS (0|1)

shopt -s dotglob    # .files matching in globs
shopt -s globstar   # ** in globs
shopt -s nocaseglob # case-insensitive globs
shopt -s nullglob   # unmatched globs expand to empty list

declare -A COUNT    # associative array

VERSION="v0.5.1"
HR="------------------------------------------------------------"

TMP_ROOT=$(mktemp -d -t cruncher-work.XXXXXX)
trap 'rm -rf "$TMP_ROOT"' EXIT INT TERM
export TMP_ROOT

OPACITIES=(
    11565:0.2%   11822:0.7%   12079:1.1%   12336:1.6%   12593:2.1%   12850:2.6%
    13107:3%     13364:3.5%   13621:4%     13878:4.5%   14135:4.9%   14392:5.4%
    14649:5.9%   14906:6.4%   15163:6.9%   15420:7.3%   15677:7.8%   15934:8.3%
    16191:8.8%   16448:9.2%   16705:9.7%   16962:~10%   17219:~10.5% 17476:~11%
    17733:~11.5% 17990:~12%   18247:~12.5% 18504:~13%   18761:~13.5% 19018:~14%
    19275:~14.5% 19532:~15%   20046:~15.5% 20303:~16%   20560:~16.5% 20817:~17%
    21074:~17.5% 21331:~18%   21588:~18.5% 21845:~19%   22102:~19.5% 22359:~20%
    25186:~25%   27756:~30%   30069:~35%   33153:~40%   35209:~45%   38550:~50%
    40606:~55%   43947:~60%   46003:~65%   49344:~70%   51143:~75%   54741:~80%
    56540:~85%   59110:~90%   59624:~91%   60138:~92%   60909:~93%   61423:~94%
    61937:~95%   62451:~96%   62965:~97%   64507:~98%   65021:~99%   65535:100%
)

function show-opacity {
    local i threshold label OP="$1"
    (( OP > 65535 )) && OP=65535
    for i in "${OPACITIES[@]}"; do
        threshold="${i%%:*}"
        label="${i#*:}"
        if (( threshold >= OP )); then
            echo "$OP (< $label)"
            return
        fi
    done
}

function set-term-title {
    echo -en "\033]2;$1\007"
}

# ignore-case search without external awk
function locate {
    local stripped="${1#./}"
    local slashes="${stripped//[^\/]/}"
    local depth=$(( ${#slashes} + 1 ))
    find -maxdepth "$depth" -iwholename "$1" -print -quit
}

function ffmpeg-version {
    local ver_out
    ver_out=$("$FFMPEG" -version 2>/dev/null)
    if [[ "$ver_out" =~ ^ffmpeg\ version\ ([0-9]+)\.([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
    else
        "$FFMPEG" -help long 2>/dev/null | grep --quiet '^-fps_mode ' && echo "6.0" || echo "4.0"
    fi
}

function validate-uint {
    local val="$1" name="$2"
    if [[ ! "$val" =~ ^[0-9]+$ ]]; then
        echo "! Error: Invalid value '$val' for $name." >&2
        exit 1
    fi
}

function parse-args {
    NAME=$(basename "$0")
    if (( $# > 0 )); then
        while getopts "m:d:q:w:o:r:t:l:peav1" OPTION; do
            case "$OPTION" in
                m) MODE=$OPTARG ;;
                d) GAMEDIR=$OPTARG ;;
                q) QUALITY=$OPTARG ;;
                w) WMETHOD=$OPTARG ;;
                o) OPACITY=$OPTARG ;;
                r) MAX_DIM=$OPTARG ;;
                t) THREADS=$OPTARG ;;
                l) LOGLEVEL=${OPTARG:--} ;;
                p) PRETEND=true ;;
                e) ERRORSONLY=true ;;
                a) ACCEL=true ;;
                v) VPARALLEL=true ;;
                1) PARALLEL_=- ;;
                ?)
                    cat <<END
Usage:
cruncher [-m MODE] [-d DIR] [-q QUAL] [-w METH] [-o OPAC]
         [-r MAX_DIM] [-t THRD] [-l LOG] [-p] [-e] [-a] [-v] [-1] [MODE]

MODE       RenPy | RPGM | Ace | Other (auto-detected)
GAMEDIR    Target folder (default: ./game | ./www | .)
QUALITY    WebP/JPEG quality (default: 80)
WMETHOD    WebP compression method 0-6 (default: 5)
OPACITY    PNG transparency threshold (default: 20480=16.5%)
MAX_DIM    Max height/dimension cap in px, 0 to disable (default: 720)
THREADS    ffmpeg threads (default: 0, or 1 w/ -v)
LOGLEVEL   ffmpeg flags (default: warning -stats)
-p         PRETEND: dry run, count files only
-e         ERRORSONLY: print errors only
-a         ACCEL: fast single-pass VP9 mobile preset (Termux/JoiPlay safe)
-v         VPARALLEL: parallel video encoding
-1         PARALLEL_: disable parallel processing

Env vars also supported: FFMPEG, CONVERT, VAAPI_DEVICE, MAX_DIM,
PARALLEL_, RPATOOL, MVDECRYPTOR, RGSSDECRYPTOR.
END
                    exit 1
                    ;;
            esac
        done
        (( $# - OPTIND >= 0 )) && MODE=${@:$OPTIND:1}
    fi

    if [ -z "$MODE" ]; then
        if [[ "$NAME" = RenCruncher* ]]; then
            MODE=RenPy
        elif [[ "$NAME" = RPGMCruncher* ]]; then
            MODE=RPGM
        elif [[ "$NAME" = AceCruncher* ]]; then
            MODE=Ace
        elif [[ "$NAME" = OtherCruncher* ]]; then
            MODE=Other
        elif [ -d ./game ] || [ -f "$(locate './*.py')" ] || [ -f "$(locate './*.rpyc')" ] || [ -f "$(locate './*.rpyb')" ]; then
            MODE=RenPy
        elif [ -f "$(locate './www/data/System.json')" ]; then
            MODE=RPGM
        elif [ -f "$(locate './Game.ini')" ] && [ -f "$(locate './System/RGSS*.dll')" ]; then
            MODE=Ace
        else
            MODE=Other
        fi
    fi

    GAME="$([ -n "$GAMEDIR" ] && realpath "$GAMEDIR" || basename "$PWD")"
    GAME="${GAME%_compressed}"

    _PARALLEL="$(command -v parallel 2>/dev/null)"
    [ -n "$PARALLEL_" ] && [ "$PARALLEL_" != "-" ] && _PARALLEL="$PARALLEL_"
    : "${PARALLEL_:=$_PARALLEL}"
    : "${RPATOOL:=$(command -v rpatool 2>/dev/null || command -v rpatool.py 2>/dev/null)}"
    : "${MVDECRYPTOR:=$(command -v mvdecryptor 2>/dev/null)}"
    : "${RGSSDECRYPTOR:=$(command -v rgssdecryptor 2>/dev/null)}"

    [ "$ERRORSONLY" = true ] || ERRORSONLY=false
    local _LOGLEVEL
    $ERRORSONLY && _LOGLEVEL='fatal -nostats' || _LOGLEVEL='warning -stats'
    if [ "$LOGLEVEL" = "-" ]; then
        LOGLEVEL=""
    else
        : "${LOGLEVEL:=-hide_banner -loglevel $_LOGLEVEL}"
    fi
}

function assert-executable {
    if [ ! -x "$1" ] || [ -d "$1" ]; then
        cat <<END
! Error: Cannot locate $2 executable.
  Install ${3:-$2} or set ${2^^} to its path.
END
        read -r -p "Press Enter to exit..."
        exit 1
    fi
}

function splash {
    cat <<END
$HR
  $NAME - ${MODE_} Media Compactor ${VERSION}
$HR
END
}

function warning {
    cat <<END
$HR
*** WARNING: OVERWRITES FILES IN ${MODE_^^} GAME
*** NO BACKUPS CREATED - CLOSE NOW TO CANCEL
$HR
END
}

function init {
    MODE_=$MODE
    case "$MODE" in
        RenPy)
            : "${GAMEDIR:=./game}"
            NAME=RenCruncher
            MODE_="Ren'Py"
            ;;
        RPGM)
            : "${GAMEDIR:=$(locate './www')}"
            NAME=RPGMCruncher
            ;;
        Ace)
            : "${GAMEDIR:=.}"
            NAME=AceCruncher
            MODE_="RPGM VX Ace"
            ;;
        *)
            : "${GAMEDIR:=.}"
            NAME=OtherCruncher
            ;;
    esac

    : "${FFMPEG:=$(command -v ffmpeg)}"
    : "${VAAPI_DEVICE:=/dev/dri/renderD128}"

    # ImageMagick v7 (magick) with v6 (convert) fallback
    if [ -z "$CONVERT" ]; then
        if command -v magick >/dev/null 2>&1; then
            CONVERT="$(command -v magick)"
        else
            CONVERT="$(command -v convert)"
        fi
    fi

    : "${QUALITY:=80}"
    : "${WMETHOD:=5}"
    : "${OPACITY:=20480}"
    : "${MAX_DIM:=720}"
    [ "$PRETEND" = true ] || PRETEND=false
    [ "$ACCEL" = true ] || ACCEL=false
    [ "$VPARALLEL" = true ] || VPARALLEL=false

    if [ -z "$THREADS" ]; then
        [ "$VPARALLEL" = true ] && THREADS=1 || THREADS=0
    fi

    validate-uint "$QUALITY" "QUALITY"
    validate-uint "$WMETHOD" "WMETHOD"
    validate-uint "$OPACITY" "OPACITY"
    validate-uint "$MAX_DIM" "MAX_DIM"
    validate-uint "$THREADS" "THREADS"

    $ERRORSONLY && VERBOSE='-quiet' || VERBOSE='-verbose'
    COUNT=()
    clear
    set-term-title "$NAME {$GAME}"
    splash
    $PRETEND && echo "  [Pretend mode: scanning files only]"

    if [ ! -d "$GAMEDIR" ]; then
        cat <<END
! Error: Cannot locate ${MODE_} game folder.
  Run this script in the game executable folder.
END
        read -r -p "Press Enter to exit..."
        exit 1
    fi

    assert-executable "$FFMPEG"  ffmpeg
    assert-executable "$CONVERT" convert "imagemagick"

    local ff_ver ff_major ff_minor
    ff_ver=$(ffmpeg-version)
    ff_major=${ff_ver%%.*}
    ff_minor=${ff_ver#*.}
    if (( ff_major < 5 || (ff_major == 5 && ff_minor < 1) )); then
        FPSMODE='-vsync'
    else
        FPSMODE='-fps_mode'
    fi

    [[ ! -x "$RPATOOL" || -d "$RPATOOL" ]] && RPATOOL=""
    [[ ! -x "$MVDECRYPTOR" || -d "$MVDECRYPTOR" ]] && MVDECRYPTOR=""
    [[ ! -x "$RGSSDECRYPTOR" || -d "$RGSSDECRYPTOR" ]] && RGSSDECRYPTOR=""
    [[ "$PARALLEL_" = '-' || ! -x "$PARALLEL_" || -d "$PARALLEL_" ]] && PARALLEL_=""
    [ -n "$PARALLEL_" ] || VPARALLEL=false

    if $VPARALLEL || $ACCEL; then
        VLOGLEVEL="$LOGLEVEL"
    else
        VLOGLEVEL="${LOGLEVEL/-nostats/-stats}"
    fi
}

function menu {
    echo
    warning
    cat <<END
Select action:
  1) Image Files          2) Audio Files
  3) Video Files          5) All Media
END
    if [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ]; then
        cat <<END
  x) Extract *.rpa        c) Repack *.rpa/
END
    fi
    if [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ]; then
        cat <<END
  d) Decrypt MV files     D) Decrypt MV (auto-key)
END
    fi
    if [ "$MODE" = Ace ] && [ -n "$RGSSDECRYPTOR" ]; then
        cat <<END
  r) Extract Game.rgss3a (irreversible)
END
    fi
    cat <<END
  i) Runtime parameters   q) Exit
$HR
END

    read -r -p "Choice: "
    echo "$HR"
    export TOTAL_TIME=0
    case "$REPLY" in
        1)
            images
            report image
            ;;
        2)
            audio
            report audio
            ;;
        3)
            video
            report video
            ;;
        5)
            images
            audio
            video
            report image audio video
            ;;
        x) [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ] && rpa unpack ;;
        c) [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ] && rpa repack ;;
        d) [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ] && "$MVDECRYPTOR" ;;
        D) [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ] && DETECT=yes "$MVDECRYPTOR" ;;
        r) [ "$MODE" = Ace ] && [ -n "$RGSSDECRYPTOR" ] && rgss-unpack ;;
        i) params-info ;;
        q|Q|exit) return 1 ;;
    esac
    return $?
}

function params-info {
    clear
    local PARALLEL
    [ -n "$PARALLEL_" ] && PARALLEL="$PARALLEL_" || PARALLEL="- ($_PARALLEL)"
    cat <<END
$HR
  Runtime Parameters
$HR
GAMEDIR      : $(realpath "$GAMEDIR")
MODE         : $MODE
QUALITY      : $QUALITY (WMETHOD: $WMETHOD)
OPACITY      : $(show-opacity "$OPACITY")
MAX_DIM      : ${MAX_DIM}px (0 = disabled)
THREADS      : $THREADS (VPARALLEL: $VPARALLEL)
ACCEL        : $ACCEL (Fast Single-Pass VP9)
ERRORSONLY   : $ERRORSONLY
LOGLEVEL     : ${LOGLEVEL:-none}
$HR
PARALLEL_    : $PARALLEL
FFMPEG       : $FFMPEG (v$(ffmpeg-version))
CONVERT      : $CONVERT
RPATOOL      : ${RPATOOL:-none}
MVDECRYPTOR  : ${MVDECRYPTOR:-none}
RGSSDECRYPTOR: ${RGSSDECRYPTOR:-none}
$HR
END
    read -r -p "Press Enter to continue..."
}

function rpa {
    pushd "$GAMEDIR" >/dev/null || return
    local FILES=( **/*.rpa )
    local COUNTER=0
    local FILE
    for FILE in "${FILES[@]}"; do
        [ -e "$FILE" ] || continue
        [[ "$1" = unpack && ! -d "$FILE" ]] || [[ "$1" = repack && -d "$FILE" ]] || continue
        echo "  $FILE" && (( COUNTER++ ))
        if [ "$1" = unpack ]; then
            "$RPATOOL" -xo "$FILE~/" "$FILE" || { popd >/dev/null; exit 1; }
        else
            pushd "$FILE" >/dev/null || { popd >/dev/null; return; }
            "$RPATOOL" -c "../$(basename "$FILE")~" ./* || { popd >/dev/null; popd >/dev/null; exit 1; }
            popd >/dev/null || exit 1
        fi
        rm -r "$FILE"
        mv "$FILE"{~,}
    done
    popd >/dev/null || return
    read -r -p "${1^}ed $COUNTER archives. Press Enter..."
}

function rgss-unpack {
    local FILE
    FILE="$(locate ./Game.rgss3a)"
    FILE="${FILE#./}"
    local MSG
    if [ ! -f "$FILE" ]; then
        MSG="Game.rgss3a not found. Press Enter..."
    else
        "$RGSSDECRYPTOR" --proj "$FILE" && rm --verbose --interactive=never "$FILE" \
            && MSG="Unpacked '$FILE'. Press Enter..." \
            || MSG="Failed unpacking '$FILE'. Press Enter..."
    fi
    read -r -p "$MSG"
}

function filesize        { stat -c%s -- "$1"; }
function hex-bytes       { for i in "$@"; do printf '\\x%02x' $((0xFF & i)); done; }
function little-endian   { echo -ne "$(hex-bytes "$1" $(($1>>8)) $(($1>>16)) $(($1>>24)))"; }
function webp-header-fix { little-endian $(($(filesize "$1") - 8)) | dd of="$1" obs=1 seek=4 conv=notrunc status=none; }
export -f filesize hex-bytes little-endian webp-header-fix

function convert-image {
    local -a resize_args=()
    # Cap largest side at MAX_DIM only if larger (>), skipping RPGM sprite sheets/tilesets/faces/system UI
    if (( MAX_DIM > 0 )); then
        if [ "$MODE" != RPGM ] || [[ "${1,,}" != img/@(characters|tilesets|faces|system|sv_actors|sv_enemies)/* ]]; then
            resize_args=(-resize "${MAX_DIM}x${MAX_DIM}>")
        fi
    fi
    "$CONVERT" "$VERBOSE" "$1" "${resize_args[@]}" -quality "$QUALITY" -define webp:method="$WMETHOD" WEBP:"$2"
}

function convert-parallax {
    local -a resize_args=()
    (( MAX_DIM > 0 )) && resize_args=(-resize "${MAX_DIM}x${MAX_DIM}>")
    "$CONVERT" "$VERBOSE" "$1" "${resize_args[@]}" -define webp:lossless=true WEBP:"$2"
}

function convert-jpgpng {
    local -a resize_args=()
    (( MAX_DIM > 0 )) && resize_args=(-resize "${MAX_DIM}x${MAX_DIM}>")
    # check for transparent pixels
    if (( $("$CONVERT" "$1" -alpha extract -format '%[min]' info:) < OPACITY )); then
        # for PNG: -quality {compression-level}{filter-type}
        "$CONVERT" -regard-warnings "$VERBOSE" "$1" "${resize_args[@]}" -quality 95 PNG:"$2"
    else
        "$CONVERT" -regard-warnings "$VERBOSE" "$1" "${resize_args[@]}" -quality "$QUALITY" JPEG:"$2"
    fi
}
export -f convert-parallax convert-image convert-jpgpng

function convert-audio {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -map_metadata -1 -codec:a libopus -vn -b:a 32k -compression_level 10 -vbr on -f ogg "$2" "${log_args[@]}"
}
function convert-mp3 {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -map_metadata -1 -codec:a libmp3lame -qscale:a 7 -vn -f mp3 "$2" "${log_args[@]}"
}
function convert-ogg {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -codec:a libvorbis -qscale:a 3 -f ogg "$2" "${log_args[@]}"
}
export -f convert-audio convert-mp3 convert-ogg

function convert-webm {
    local PASSLOG
    PASSLOG="$(mktemp -p "$TMP_ROOT" "passlog.XXXXXX")"
    local -a vlog_args=()
    [ -n "$VLOGLEVEL" ] && read -ra vlog_args <<< "$VLOGLEVEL"

    # Cap height at MAX_DIM (no upscaling), ensure even dimensions & 8-bit yuv420p for JoiPlay/MaldiVes
    local VF_ARGS="format=yuv420p"
    if (( MAX_DIM > 0 )); then
        VF_ARGS="scale=-2:'min(${MAX_DIM},ih)',format=yuv420p"
    else
        VF_ARGS="scale=trunc(iw/2)*2:trunc(ih/2)*2,format=yuv420p"
    fi

    if $ACCEL; then
        # Fast single-pass VP9 tuned for Termux ARM CPUs (JoiPlay/MaldiVes safe)
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good \
            -b:v 0 -crf 38 -speed 5 -tile-columns 2 -frame-parallel 1 -g 120 \
            -c:a libopus -vbr on -compression_level:a 10 -frame_duration 20 -application audio -b:a 32k \
            -f webm "$2" "${vlog_args[@]}"
    else
        # Higher compression 2-pass VP9
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good -pass 1 \
            -b:v 0 -crf 38 -speed 5 -tile-columns 2 -frame-parallel 1 -g 120 -an \
            -passlogfile "$PASSLOG" -f webm /dev/null "${vlog_args[@]}" && \
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good -pass 2 \
            -b:v 0 -crf 38 -speed 3 -tile-columns 2 -frame-parallel 1 -auto-alt-ref 1 -lag-in-frames 16 -g 120 \
            -c:a libopus -vbr on -compression_level:a 10 -frame_duration 20 -application audio -b:a 32k \
            -passlogfile "$PASSLOG" -f webm "$2" "${vlog_args[@]}"
    fi
    local STATUS=$?
    rm -f "${PASSLOG}"*
    return $STATUS
}

function convert-ogv {
    local PASSLOG
    PASSLOG="$(mktemp -p "$TMP_ROOT" "passlog.XXXXXX")"
    local -a vlog_args=()
    [ -n "$VLOGLEVEL" ] && read -ra vlog_args <<< "$VLOGLEVEL"

    "$FFMPEG" -y -i "$1" -c:v libtheora -threads "$THREADS" -pass 1 -g 240 -vsync 2 -an \
        -passlogfile "$PASSLOG" -f ogv /dev/null "${vlog_args[@]}" && \
    "$FFMPEG" -y -i "$1" -c:v libtheora -threads "$THREADS" -pass 2 -g 240 -vsync 2 -c:a libvorbis -compression_level 10 \
        -passlogfile "$PASSLOG" -f ogv "$2" "${vlog_args[@]}"
    local STATUS=$?
    rm -f "${PASSLOG}"*
    return $STATUS
}
export -f convert-webm convert-ogv

function images {
    local EXT
    if [ "$MODE" = Ace ]; then
        for EXT in jpg jpeg png; do process image "$EXT" jpgpng; done
    elif [ "$MODE" = RPGM ]; then
        # Skip gif in RPGM to avoid animated WebP crashes in mobile WebViews
        for EXT in webp jpg jpeg bmp png; do process image "$EXT"; done
    else
        for EXT in webp jpg jpeg bmp png gif; do process image "$EXT"; done
    fi
}

function audio {
    local EXT
    if [[ "$MODE" = @(RPGM|Ace) ]]; then
        process audio mp3 mp3
        process audio wav mp3
        process audio ogg ogg
    else
        for EXT in mp3 wav ogg opus; do process audio "$EXT"; done
    fi
}

function video {
    local FMT EXT
    [ "$MODE" = Ace ] && FMT=ogv || FMT=webm
    for EXT in webm mp4 mkv m4v mpg mov ogv avi; do process video "$EXT" "$FMT"; done
}

function show-time {
    local N="$1"
    if (( N < 60 )); then
        echo "${N}s"
    else
        printf '%dm%02ds\n' $(( N / 60 )) $(( N % 60 ))
    fi
}

function show-progress {
    local CURRENT="$1" TOTAL="$2" EXT="$3" EXTRA="${*:4}"
    local PERCENT=0 BAR_W=24 FILLED=0
    (( TOTAL > 0 )) && PERCENT=$(( CURRENT * 100 / TOTAL ))
    FILLED=$(( PERCENT * BAR_W / 100 ))
    local BAR=""
    (( FILLED > 0 )) && printf -v BAR "%${FILLED}s" "" && BAR="${BAR// /#}"
    local PAD=""
    (( BAR_W - FILLED > 0 )) && printf -v PAD "%$(( BAR_W - FILLED ))s" "" && PAD="${PAD// /.}"

    set-term-title "$NAME: ${EXT^^} $CURRENT/$TOTAL (${PERCENT}%) $EXTRA {$GAME}"
    printf "\r%-4s [%s%s] %3d%% (%d/%d) %-10s" "$EXT" "$BAR" "$PAD" "$PERCENT" "$CURRENT" "$TOTAL" "$EXTRA" >&2
    (( CURRENT == TOTAL && TOTAL > 0 )) && echo >&2
}

function apply-conversion {
    local TYPE="$1"
    local EXT="$2"
    local FILE="$3"
    local CONV_TYPE="$4"
    local _VERBOSE=""

    if [[ ( "$TYPE" = video && "$VPARALLEL" != true && "$ACCEL" != true ) || "$VERBOSE" = '-verbose' ]]; then
        _VERBOSE='--verbose'
    fi

    [ -n "$_VERBOSE" ] && echo "Processing: $FILE" >&2

    # Save original permissions and ensure write access
    local ORIG_PERMS
    ORIG_PERMS=$(stat -c '%a' -- "$FILE")
    chmod +w -- "$FILE"

    if [ "$MODE" = RenPy ] && [ "$EXT" = webp ]; then
        webp-header-fix "$FILE"
        [ -n "$_VERBOSE" ] && echo "  WebP header rewritten." >&2
    fi

    local BUFFER
    BUFFER="$(mktemp -p "$TMP_ROOT" "buf.XXXXXX")"
    chmod "$ORIG_PERMS" -- "$BUFFER"

    if [ "$MODE" = RPGM ] && [[ "${FILE,,}" = img/parallaxes/* ]]; then
        convert-parallax "$FILE" "$BUFFER"
    else
        convert-"$CONV_TYPE" "$FILE" "$BUFFER"
    fi

    local CONV_STATUS=$?
    if (( CONV_STATUS != 0 )); then
        echo "! ERROR: Conversion failed for $FILE" >&2
    elif [ ! -s "$BUFFER" ]; then
        echo "! ERROR: 0-byte output, reverting $FILE" >&2
    elif (( $(filesize "$BUFFER") >= $(filesize "$FILE") )); then
        [ -n "$_VERBOSE" ] && echo "  SKIP: Larger than original ($FILE)" >&2
    else
        touch -r "$FILE" "$BUFFER"
        mv ${_VERBOSE:+"$_VERBOSE"} -- "$BUFFER" "$FILE" >&2
    fi

    chmod "$ORIG_PERMS" -- "$FILE" 2>/dev/null
    rm -f "$BUFFER"

    if [ -n "$DONE" ]; then
        echo -n . >> "$DONE"
        local COUNTER PERCENT=0
        COUNTER=$(filesize "$DONE")
        (( TOTAL > 0 )) && PERCENT=$(( COUNTER * 100 / TOTAL ))
        set-term-title "$NAME: ${EXT^^} $COUNTER/$TOTAL (${PERCENT}%) {$GAME}"
        echo -e "# ${EXT^^}: $COUNTER/$TOTAL\n$PERCENT"
    fi
}
export -f apply-conversion set-term-title

function process {
    local TYPE="$1"
    local EXT="$2"
    local CONV_TYPE="${3:-$TYPE}"

    pushd "$GAMEDIR" >/dev/null || return
    local -a FILES=()
    mapfile -d '' FILES < <(find . -type f -iname "*.$EXT" -printf '%P\0')
    local TOTAL=${#FILES[@]}

    ! $PRETEND && echo -e "# ${EXT^^}: 0/$TOTAL\n0"

    if (( TOTAL <= 0 )); then
        $PRETEND || $ERRORSONLY || echo "  No .$EXT ($TYPE) files found." >&2
    else
        if ! $PRETEND; then
            $ERRORSONLY || echo "  Found $TOTAL .$EXT ($TYPE) files..." >&2
            local START=$SECONDS
            set-term-title "$NAME: ${EXT^^} | $TOTAL $TYPE files {$GAME}"

            if [ -n "$PARALLEL_" ] && { [ "$TYPE" != video ] || $VPARALLEL; }; then
                export GAMEDIR MODE CONVERT FFMPEG VAAPI_DEVICE FPSMODE QUALITY WMETHOD OPACITY MAX_DIM THREADS LOGLEVEL VLOGLEVEL ACCEL VERBOSE VPARALLEL TMP_ROOT
                export GAME NAME TOTAL START AV_LOG_FORCE_COLOR=yes
                DONE="$(mktemp -p "$TMP_ROOT" "done-$EXT.XXXXXX")"
                export DONE

                printf '%s\0' "${FILES[@]}" | "$PARALLEL_" -0 --bar apply-conversion "$TYPE" "$EXT" {} "$CONV_TYPE"
                rm -f "$DONE"
                unset DONE
            else
                local COUNTER=0 FILE ELAPSED ETA
                show-progress "$COUNTER" "$TOTAL" "$EXT"
                for FILE in "${FILES[@]}"; do
                    (( COUNTER++ ))
                    apply-conversion "$TYPE" "$EXT" "$FILE" "$CONV_TYPE"
                    ELAPSED=$(( SECONDS - START ))
                    ETA=0
                    (( COUNTER > 0 )) && ETA=$(( ELAPSED * (TOTAL - COUNTER) / COUNTER ))
                    show-progress "$COUNTER" "$TOTAL" "$EXT" "ETA $(show-time "$ETA")"
                done
            fi

            local DURATION=$(( SECONDS - START ))
            TOTAL_TIME=$(( TOTAL_TIME + DURATION ))
            echo "  Done: $TOTAL .$EXT files in $(show-time "$DURATION")." >&2
        fi
        COUNT[$EXT]="$TOTAL"
    fi

    popd >/dev/null || return
}

function count {
    printf "%-4s: %4d" "$1" "${COUNT[$1]:-0}"
}

function report {
    $PRETEND || set-term-title "$NAME: Finished {$GAME}"
    echo
    echo "$HR"
    if $PRETEND; then
        echo "  Scan Summary (Dry Run)"
    else
        echo "  Compression Summary (Time: $(show-time "$TOTAL_TIME"))"
    fi
    echo "$HR"

    if [[ " $* " =~ " image " ]]; then
        printf "  [Images] %s | %s | %s\n" "$(count webp)" "$(count jpg)" "$(count jpeg)"
        printf "           %s | %s | %s\n" "$(count bmp)"  "$(count png)" "$(count gif)"
    fi
    if [[ " $* " =~ " audio " ]]; then
        printf "  [Audio]  %s | %s | %s | %s\n" "$(count mp3)" "$(count ogg)" "$(count opus)" "$(count wav)"
    fi
    if [[ " $* " =~ " video " ]]; then
        printf "  [Video]  %s | %s | %s | %s\n" "$(count webm)" "$(count mp4)" "$(count mkv)" "$(count m4v)"
        printf "           %s | %s | %s | %s\n" "$(count mpg)"  "$(count mov)" "$(count ogv)" "$(count avi)"
    fi
    echo "$HR"

    if $PRETEND; then
        return 1
    else
        read -r -p "Enter '1' for menu, any other key to exit: "
        echo "$HR"
        [[ "$REPLY" = 1 ]]
        return $?
    fi
}

function grep+ {
    [ -n "$2" ] && [ "$2" != / ] && grep --colour -oEH "$1" "${@:3}" "$2"
}

function extra-info {
    if [ "$MODE" = RPGM ]; then
        echo "  RPGM Encryption Key:"
        grep+ '"encryptionKey":\s*"[^"]*"' "$(locate "$GAMEDIR/data/System.json")"
        grep+ '[_[:alnum:]]+\._encryptionKey\s*=[^;]*;?' "$(locate "$GAMEDIR/js")/" -R
    fi
}

# won't be executed when sourcing this file
if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
    parse-args "$@"
    while :; do
        init
        PRETEND=true images
        PRETEND=true audio
        PRETEND=true video
        PRETEND=true report image audio video
        extra-info
        ! $PRETEND && menu || break
    done
fi
$PRETEND || set-term-title "${PWD##*/}"
