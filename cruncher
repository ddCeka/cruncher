#!/bin/bash
# accepted vars: MODE (RenPy|RPGM|Ace|Godot|Other), GAMEDIR (./game|./www|.), FFMPEG, CONVERT, PCKT, PYTHON3, GODOT_HELPER, VAAPI_DEVICE, QUALITY (80), MAX_DIM (720), THREADS (0|1)

shopt -s dotglob    # .files matching in globs
shopt -s globstar   # ** in globs
shopt -s nocaseglob # case-insensitive globs
shopt -s nullglob   # unmatched globs expand to empty list

declare -A COUNT    # associative array

VERSION="v0.5.6"
COLS=60
HR="------------------------------------------------------------"

TMP_ROOT=$(mktemp -d -t cruncher-work.XXXXXX)
trap 'rm -rf "$TMP_ROOT"' EXIT INT TERM
export TMP_ROOT

OPACITIES=(
    11565:0.2%   11822:0.7%   12079:1.1%   12336:1.6%   12593:2.1%   12850:2.6%
    13107:3%     13364:3.5%   13621:4%     13878:4.5%   14135:4.9%   14392:5.4%
    14649:5.9%   14906:6.4%   15163:6.9%   15420:7.3%   15677:7.8%   15934:8.3%
    16191:8.8%   16448:9.2%   16705:9.7%   16962:~10%   17219:~10.5% 17476:~11%
    17733:~11.5% 17990:~12%   18247:~12.5% 18504:~13%   18761:~13.5% 19018:~14%
    19275:~14.5% 19532:~15%   20046:~15.5% 20303:~16%   20560:~16.5% 20817:~17%
    21074:~17.5% 21331:~18%   21588:~18.5% 21845:~19%   22102:~19.5% 22359:~20%
    25186:~25%   27756:~30%   30069:~35%   33153:~40%   35209:~45%   38550:~50%
    40606:~55%   43947:~60%   46003:~65%   49344:~70%   51143:~75%   54741:~80%
    56540:~85%   59110:~90%   59624:~91%   60138:~92%   60909:~93%   61423:~94%
    61937:~95%   62451:~96%   62965:~97%   64507:~98%   65021:~99%   65535:100%
)

function fit60 {
    local s="$1" max="${2:-$COLS}"
    if (( ${#s} > max )); then
        printf '%s...' "${s:0:$((max - 3))}"
    else
        printf '%s' "$s"
    fi
}

function fit60-path {
    local p="$1" max="${2:-$COLS}"
    if (( ${#p} > max )); then
        local keep=$(( max - 3 ))
        printf '...%s' "${p:$(( ${#p} - keep )):$keep}"
    else
        printf '%s' "$p"
    fi
}

function show-opacity {
    local i threshold label OP="$1"
    (( OP > 65535 )) && OP=65535
    for i in "${OPACITIES[@]}"; do
        threshold="${i%%:*}"
        label="${i#*:}"
        if (( threshold >= OP )); then
            echo "$OP (< $label)"
            return
        fi
    done
}

function set-term-title {
    echo -en "\033]2;$1\007"
}

function locate {
    local stripped="${1#./}"
    local slashes="${stripped//[^\/]/}"
    local depth=$(( ${#slashes} + 1 ))
    find -maxdepth "$depth" -iwholename "$1" -print -quit
}

function has-embedded-pck {
    local f
    for f in ./*; do
        [ -f "$f" ] || continue
        case "${f,,}" in
            *.pck|*.sh|*.py|*.txt|*.md|*.json|*.ini|*.dll|*.so|*.dylib) continue ;;
        esac
        local sz
        sz=$(stat -c%s -- "$f" 2>/dev/null) || continue
        (( sz > 128 )) || continue
        local tail_magic
        tail_magic=$(tail -c 4 -- "$f" 2>/dev/null | tr -d '\0')
        if [ "$tail_magic" = "GDPC" ]; then
            echo "$f"
            return 0
        fi
    done
    return 1
}

function ffmpeg-version {
    local ver_out
    ver_out=$("$FFMPEG" -version 2>/dev/null)
    if [[ "$ver_out" =~ ^ffmpeg\ version\ ([0-9]+)\.([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
    else
        "$FFMPEG" -help long 2>/dev/null | grep --quiet '^-fps_mode ' && echo "6.0" || echo "4.0"
    fi
}

function validate-uint {
    local val="$1" name="$2"
    if [[ ! "$val" =~ ^[0-9]+$ ]]; then
        echo "! Error: Invalid value '$val' for $name." >&2
        exit 1
    fi
}

function usage {
    cat <<END
$HR
Usage: cruncher [options] [MODE]
  -m MODE    RenPy | RPGM | Ace | Godot | Other
  -d DIR     Target folder (./game | ./www | .)
  -q QUAL    WebP/JPEG quality (default: 80)
  -w METH    WebP method 0-6 (default: 5)
  -o OPAC    PNG alpha threshold (default: 20480=16.5%)
  -r DIM     Max dimension px, 0=off (default: 720)
  -t THRD    ffmpeg threads (default: 0, 1 w/ -v)
  -l LOG     ffmpeg flags (default: warning -stats)
  -p         Pretend mode (dry run scan only)
  -e         Print errors only
  -a         Fast single-pass mobile VP9 encoding
  -v         Parallel video encoding
  -1         Disable GNU parallel processing
  -h         Show this help message and exit

Env: FFMPEG, CONVERT, PCKT, PYTHON3, GODOT_HELPER,
     VAAPI_DEVICE, PARALLEL_, RPATOOL, MVDECRYPTOR,
     RGSSDECRYPTOR.
$HR
END
}

function parse-args {
    NAME=$(basename "$0")
    local arg
    for arg in "$@"; do
        if [ "$arg" = "--help" ]; then
            usage
            exit 0
        fi
    done

    if (( $# > 0 )); then
        while getopts "m:d:q:w:o:r:t:l:peav1h" OPTION; do
            case "$OPTION" in
                m) MODE=$OPTARG ;;
                d) GAMEDIR=$OPTARG ;;
                q) QUALITY=$OPTARG ;;
                w) WMETHOD=$OPTARG ;;
                o) OPACITY=$OPTARG ;;
                r) MAX_DIM=$OPTARG ;;
                t) THREADS=$OPTARG ;;
                l) LOGLEVEL=${OPTARG:--} ;;
                p) PRETEND=true ;;
                e) ERRORSONLY=true ;;
                a) ACCEL=true ;;
                v) VPARALLEL=true ;;
                1) PARALLEL_=- ;;
                h)
                    usage
                    exit 0
                    ;;
                ?)
                    usage
                    exit 1
                    ;;
            esac
        done
        (( $# - OPTIND >= 0 )) && MODE=${@:$OPTIND:1}
    fi

    if [ -z "$MODE" ]; then
        if [[ "$NAME" = RenCruncher* ]]; then
            MODE=RenPy
        elif [[ "$NAME" = RPGMCruncher* ]]; then
            MODE=RPGM
        elif [[ "$NAME" = AceCruncher* ]]; then
            MODE=Ace
        elif [[ "$NAME" = GodotCruncher* ]]; then
            MODE=Godot
        elif [[ "$NAME" = OtherCruncher* ]]; then
            MODE=Other
        elif [ -d ./game ] || [ -f "$(locate './*.py')" ] || [ -f "$(locate './*.rpyc')" ] || [ -f "$(locate './*.rpyb')" ]; then
            MODE=RenPy
        elif [ -f "$(locate './www/data/System.json')" ] || [ -f "$(locate './data/System.json')" ]; then
            MODE=RPGM
        elif [ -f "$(locate './Game.ini')" ] && [ -f "$(locate './System/RGSS*.dll')" ]; then
            MODE=Ace
        elif [ -f "$(locate './*.pck')" ] || [ -f "$(locate './project.godot')" ] || has-embedded-pck >/dev/null; then
            MODE=Godot
        else
            MODE=Other
        fi
    fi

    GAME="$([ -n "$GAMEDIR" ] && realpath "$GAMEDIR" || basename "$PWD")"
    GAME="${GAME%_compressed}"

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    _PARALLEL="$(command -v parallel 2>/dev/null)"
    [ -n "$PARALLEL_" ] && [ "$PARALLEL_" != "-" ] && _PARALLEL="$PARALLEL_"
    : "${PARALLEL_:=$_PARALLEL}"
    : "${PCKT:=$(command -v pckt 2>/dev/null || { [ -x ./pckt ] && realpath ./pckt; })}"
    : "${PYTHON3:=$(command -v python3 2>/dev/null)}"
    if [ -z "$GODOT_HELPER" ]; then
        if [ -f "$script_dir/godot-repack-helper.py" ]; then
            GODOT_HELPER="$script_dir/godot-repack-helper.py"
        elif [ -f "./godot-repack-helper.py" ]; then
            GODOT_HELPER="$(realpath ./godot-repack-helper.py)"
        elif command -v godot-repack-helper.py >/dev/null 2>&1; then
            GODOT_HELPER="$(command -v godot-repack-helper.py)"
        fi
    fi
    : "${RPATOOL:=$(command -v rpatool 2>/dev/null || command -v rpatool.py 2>/dev/null)}"
    : "${MVDECRYPTOR:=$(command -v mvdecryptor 2>/dev/null)}"
    : "${RGSSDECRYPTOR:=$(command -v rgssdecryptor 2>/dev/null)}"

    [ "$ERRORSONLY" = true ] || ERRORSONLY=false
    local _LOGLEVEL
    $ERRORSONLY && _LOGLEVEL='fatal -nostats' || _LOGLEVEL='warning -stats'
    if [ "$LOGLEVEL" = "-" ]; then
        LOGLEVEL=""
    else
        : "${LOGLEVEL:=-hide_banner -loglevel $_LOGLEVEL}"
    fi
}

function assert-executable {
    if [ ! -x "$1" ] || [ -d "$1" ]; then
        echo "$HR"
        fit60 "! Error: Cannot locate $2 executable."
        echo
        fit60 "  Install ${3:-$2} or set ${2^^} to its path."
        echo
        echo "$HR"
        read -r -p "Press Enter to exit..."
        exit 1
    fi
}

function splash {
    echo "$HR"
    fit60 "  $NAME - ${MODE_} Media Compactor ${VERSION}"
    echo
    echo "$HR"
}

function warning {
    echo "$HR"
    fit60 "*** WARNING: OVERWRITES FILES IN ${MODE_^^} GAME"
    echo
    fit60 "*** NO BACKUPS CREATED - CLOSE NOW TO CANCEL"
    echo
    echo "$HR"
}

function init {
    MODE_=$MODE
    case "$MODE" in
        RenPy)
            : "${GAMEDIR:=./game}"
            NAME=RenCruncher
            MODE_="Ren'Py"
            ;;
        RPGM)
            : "${GAMEDIR:=$(locate './www')}"
            : "${GAMEDIR:=.}"
            NAME=RPGMCruncher
            ;;
        Ace)
            : "${GAMEDIR:=.}"
            NAME=AceCruncher
            MODE_="RPGM VX Ace"
            ;;
        Godot)
            : "${GAMEDIR:=.}"
            NAME=GodotCruncher
            MODE_="Godot"
            ;;
        *)
            : "${GAMEDIR:=.}"
            NAME=OtherCruncher
            ;;
    esac

    : "${FFMPEG:=$(command -v ffmpeg)}"
    : "${VAAPI_DEVICE:=/dev/dri/renderD128}"

    if [ -z "$CONVERT" ]; then
        if command -v magick >/dev/null 2>&1; then
            CONVERT="$(command -v magick)"
        else
            CONVERT="$(command -v convert)"
        fi
    fi

    : "${QUALITY:=80}"
    : "${WMETHOD:=5}"
    : "${OPACITY:=20480}"
    : "${MAX_DIM:=720}"
    [ "$PRETEND" = true ] || PRETEND=false
    [ "$ACCEL" = true ] || ACCEL=false
    [ "$VPARALLEL" = true ] || VPARALLEL=false

    if [ -z "$THREADS" ]; then
        [ "$VPARALLEL" = true ] && THREADS=1 || THREADS=0
    fi

    validate-uint "$QUALITY" "QUALITY"
    validate-uint "$WMETHOD" "WMETHOD"
    validate-uint "$OPACITY" "OPACITY"
    validate-uint "$MAX_DIM" "MAX_DIM"
    validate-uint "$THREADS" "THREADS"

    $ERRORSONLY && VERBOSE='-quiet' || VERBOSE='-verbose'
    COUNT=()
    clear
    set-term-title "$NAME {$GAME}"
    splash
    if $PRETEND; then
        fit60 "  [Pretend mode: scanning files only]"
        echo
    fi

    if [ ! -d "$GAMEDIR" ]; then
        echo "$HR"
        fit60 "! Error: Cannot locate ${MODE_} game folder."
        echo
        fit60 "  Run this script in the game executable folder."
        echo
        echo "$HR"
        read -r -p "Press Enter to exit..."
        exit 1
    fi

    assert-executable "$FFMPEG"  ffmpeg
    assert-executable "$CONVERT" convert "imagemagick"

    local ff_ver ff_major ff_minor
    ff_ver=$(ffmpeg-version)
    ff_major=${ff_ver%%.*}
    ff_minor=${ff_ver#*.}
    if (( ff_major < 5 || (ff_major == 5 && ff_minor < 1) )); then
        FPSMODE='-vsync'
    else
        FPSMODE='-fps_mode'
    fi

    [[ ! -x "$PCKT" || -d "$PCKT" ]] && PCKT=""
    [[ ! -x "$PYTHON3" || -d "$PYTHON3" ]] && PYTHON3=""
    [[ ! -f "$GODOT_HELPER" ]] && GODOT_HELPER=""
    [[ ! -x "$RPATOOL" || -d "$RPATOOL" ]] && RPATOOL=""
    [[ ! -x "$MVDECRYPTOR" || -d "$MVDECRYPTOR" ]] && MVDECRYPTOR=""
    [[ ! -x "$RGSSDECRYPTOR" || -d "$RGSSDECRYPTOR" ]] && RGSSDECRYPTOR=""
    [[ "$PARALLEL_" = '-' || ! -x "$PARALLEL_" || -d "$PARALLEL_" ]] && PARALLEL_=""
    [ -n "$PARALLEL_" ] || VPARALLEL=false

    if $VPARALLEL || $ACCEL; then
        VLOGLEVEL="$LOGLEVEL"
    else
        VLOGLEVEL="${LOGLEVEL/-nostats/-stats}"
    fi
}

function menu {
    echo
    warning
    cat <<END
Select action:
  1) Image Files          2) Audio Files
  3) Video Files          5) All Media
END
    if [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ]; then
        cat <<END
  x) Extract *.rpa        c) Repack *.rpa/
END
    fi
    if [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ]; then
        cat <<END
  d) Decrypt MV/MZ files  D) Decrypt MV/MZ (auto-key)
END
    fi
    if [ "$MODE" = Ace ] && [ -n "$RGSSDECRYPTOR" ]; then
        cat <<END
  r) Extract *.rgss* archive (irreversible)
END
    fi
    if [ "$MODE" = Godot ] && [ -n "$PCKT" ]; then
        cat <<END
  x) Unpack *.pck / exe   c) Repack *.pck/
END
    fi
    cat <<END
  i) Runtime parameters   q) Exit
$HR
END

    read -r -p "Choice: "
    echo "$HR"
    export TOTAL_TIME=0
    case "$REPLY" in
        1)
            images
            report image
            ;;
        2)
            audio
            report audio
            ;;
        3)
            video
            report video
            ;;
        5)
            images
            audio
            video
            report image audio video
            ;;
        x)
            [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ] && rpa unpack
            [ "$MODE" = Godot ] && [ -n "$PCKT" ] && godot-pck unpack
            ;;
        c)
            [ "$MODE" = RenPy ] && [ -n "$RPATOOL" ] && rpa repack
            [ "$MODE" = Godot ] && [ -n "$PCKT" ] && godot-pck repack
            ;;
        d) [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ] && mv-decrypt ;;
        D) [ "$MODE" = RPGM ] && [ -n "$MVDECRYPTOR" ] && mv-decrypt detect ;;
        r) [ "$MODE" = Ace ] && [ -n "$RGSSDECRYPTOR" ] && rgss-unpack ;;
        i) params-info ;;
        q|Q|exit) return 1 ;;
    esac
    return $?
}

function print-param {
    local label="$1" val="$2"
    local prefix
    printf -v prefix "%-13s: " "$label"
    printf "%s%s\n" "$prefix" "$(fit60-path "$val" $(( COLS - ${#prefix} )))"
}

function params-info {
    clear
    local PARALLEL
    [ -n "$PARALLEL_" ] && PARALLEL="$PARALLEL_" || PARALLEL="- ($_PARALLEL)"
    echo "$HR"
    echo "  Runtime Parameters"
    echo "$HR"
    print-param "GAMEDIR"      "$(realpath "$GAMEDIR")"
    print-param "MODE"         "$MODE"
    print-param "QUALITY"      "$QUALITY (WMETHOD: $WMETHOD)"
    print-param "OPACITY"      "$(show-opacity "$OPACITY")"
    print-param "MAX_DIM"      "${MAX_DIM}px (0=disabled)"
    print-param "THREADS"      "$THREADS (VPARALLEL: $VPARALLEL)"
    print-param "ACCEL"        "$ACCEL (Fast mobile VP9)"
    print-param "ERRORSONLY"   "$ERRORSONLY"
    print-param "LOGLEVEL"     "${LOGLEVEL:-none}"
    echo "$HR"
    print-param "PARALLEL_"    "$PARALLEL"
    print-param "FFMPEG"       "$FFMPEG (v$(ffmpeg-version))"
    print-param "CONVERT"      "$CONVERT"
    print-param "PCKT"         "${PCKT:-none}"
    print-param "PYTHON3"      "${PYTHON3:-none}"
    print-param "GODOT_HELPER" "${GODOT_HELPER:-none}"
    print-param "RPATOOL"      "${RPATOOL:-none}"
    print-param "MVDECRYPTOR"  "${MVDECRYPTOR:-none}"
    print-param "RGSSDECRYPTOR" "${RGSSDECRYPTOR:-none}"
    echo "$HR"
    read -r -p "Press Enter to continue..."
}

function rpa {
    pushd "$GAMEDIR" >/dev/null || return
    local FILES=( **/*.rpa )
    local COUNTER=0
    local FILE
    for FILE in "${FILES[@]}"; do
        [ -e "$FILE" ] || continue
        [[ "$1" = unpack && ! -d "$FILE" ]] || [[ "$1" = repack && -d "$FILE" ]] || continue
        printf "  %s\n" "$(fit60-path "$FILE" 58)"
        (( COUNTER++ ))
        if [ "$1" = unpack ]; then
            "$RPATOOL" -xo "$FILE~/" "$FILE" || { popd >/dev/null; exit 1; }
        else
            pushd "$FILE" >/dev/null || { popd >/dev/null; return; }
            "$RPATOOL" -c "../$(basename "$FILE")~" ./* || { popd >/dev/null; popd >/dev/null; exit 1; }
            popd >/dev/null || exit 1
        fi
        rm -r "$FILE"
        mv "$FILE"{~,}
    done
    popd >/dev/null || return
    read -r -p "${1^}ed $COUNTER archives. Press Enter..."
}

function godot-pck {
    pushd "$GAMEDIR" >/dev/null || return
    local COUNTER=0

    if [ "$1" = unpack ]; then
        local -a TARGETS=( *.pck )
        if (( ${#TARGETS[@]} == 0 )); then
            local emb
            emb=$(has-embedded-pck)
            [ -n "$emb" ] && TARGETS=( "${emb#./}" )
        fi

        local FILE
        for FILE in "${TARGETS[@]}"; do
            [ -f "$FILE" ] || continue
            local OUT_DIR="${FILE}.pck~"
            if [ -d "$OUT_DIR" ]; then
                printf "  %s\n" "$(fit60-path "SKIP (already unpacked): $OUT_DIR" 58)"
                continue
            fi
            printf "  %s\n" "$(fit60-path "Unpacking: $FILE -> $OUT_DIR/" 58)"
            if "$PCKT" unpack "$FILE" "$OUT_DIR"; then
                cp -p -- "$FILE" "$FILE.bak"
                (( COUNTER++ ))
            else
                echo "! Error: Failed unpacking $FILE" >&2
                rm -rf "$OUT_DIR"
            fi
        done
    else
        local -a DIRS=( *.pck~ )
        local DIR
        for DIR in "${DIRS[@]}"; do
            [ -d "$DIR" ] || continue
            local ORIG="${DIR%.pck~}"
            local META_SRC="$ORIG"
            [ -f "$ORIG.bak" ] && META_SRC="$ORIG.bak"

            local -a PACK_ARGS=()
            if [ -f "$META_SRC" ]; then
                PACK_ARGS+=( --copy-meta "$META_SRC" )
                local tail_magic
                tail_magic=$(tail -c 4 -- "$META_SRC" 2>/dev/null | tr -d '\0')
                if [ "$tail_magic" = "GDPC" ] && [[ "${META_SRC,,}" != *.pck && "${META_SRC,,}" != *.pck.bak ]]; then
                    PACK_ARGS+=( --embed "$META_SRC" )
                fi
            fi

            local TMP_OUT="$ORIG.tmp"
            printf "  %s\n" "$(fit60-path "Repacking: $DIR/ -> $ORIG" 58)"
            if "$PCKT" pack "$DIR" "$TMP_OUT" "${PACK_ARGS[@]}"; then
                mv -f -- "$TMP_OUT" "$ORIG"
                rm -rf -- "$DIR" "$ORIG.bak"
                (( COUNTER++ ))
            else
                echo "! Error: Failed repacking $DIR" >&2
                rm -f -- "$TMP_OUT"
            fi
        done
    fi

    popd >/dev/null || return
    read -r -p "${1^}ed $COUNTER archives. Press Enter..."
}

function mv-decrypt {
    local -a args=()
    [ "$1" = "detect" ] && args+=( -d )
    $ERRORSONLY || args+=( -v )

    local TARGET="$GAMEDIR"
    [[ "${TARGET,,}" == */www || "${TARGET,,}" == www ]] && TARGET="$(dirname "$TARGET")"

    if "$MVDECRYPTOR" "${args[@]}" "$TARGET"; then
        read -r -p "Decryption finished. Press Enter..."
    else
        read -r -p "! Decryption failed. Press Enter..."
    fi
}

function rgss-unpack {
    local FILE ext
    for ext in rgss3a rgss2a rgssad; do
        FILE="$(locate "$GAMEDIR/*.$ext")"
        [ -f "$FILE" ] && break
    done

    local MSG
    if [ ! -f "$FILE" ]; then
        MSG="No .rgss3a / .rgss2a / .rgssad archive found. Press Enter..."
    else
        "$RGSSDECRYPTOR" --proj "$FILE" && rm --verbose --interactive=never "$FILE" \
            && MSG="Unpacked '$(basename "$FILE")'. Press Enter..." \
            || MSG="Failed unpacking '$(basename "$FILE")'. Press Enter..."
    fi
    read -r -p "$MSG"
}

function filesize        { stat -c%s -- "$1"; }
function hex-bytes       { for i in "$@"; do printf '\\x%02x' $((0xFF & i)); done; }
function little-endian   { echo -ne "$(hex-bytes "$1" $(($1>>8)) $(($1>>16)) $(($1>>24)))"; }
function webp-header-fix {
    if [ -n "$PYTHON3" ] && [ -f "$GODOT_HELPER" ]; then
        "$PYTHON3" "$GODOT_HELPER" webp-fix "$1" >/dev/null 2>&1 || true
    else
        little-endian $(($(filesize "$1") - 8)) | dd of="$1" obs=1 seek=4 conv=notrunc status=none
    fi
}
export -f filesize hex-bytes little-endian webp-header-fix

function can-resize-image {
    local FILE="${1,,}"
    [[ -z "$MAX_DIM" || "$MAX_DIM" -le 0 ]] && return 1
    if [ "$MODE" = RPGM ]; then
        case "$FILE" in
            img/characters/*|img/tilesets/*|img/faces/*|img/system/*|img/sv_actors/*|img/sv_enemies/*)
                return 1
                ;;
        esac
    fi
    return 0
}
export -f can-resize-image

function convert-image {
    local -a resize_args=()
    can-resize-image "$1" && resize_args=( -resize "${MAX_DIM}x${MAX_DIM}>" )
    "$CONVERT" "$VERBOSE" "$1" "${resize_args[@]}" \
        -quality "$QUALITY" -define webp:method="$WMETHOD" -define webp:alpha-quality=100 \
        WEBP:"$2"
}

function convert-parallax {
    local -a resize_args=()
    can-resize-image "$1" && resize_args=( -resize "${MAX_DIM}x${MAX_DIM}>" )
    "$CONVERT" "$VERBOSE" "$1" "${resize_args[@]}" -define webp:lossless=true WEBP:"$2"
}

function convert-jpgpng {
    local -a resize_args=()
    can-resize-image "$1" && resize_args=( -resize "${MAX_DIM}x${MAX_DIM}>" )
    if (( $("$CONVERT" "$1" -alpha extract -format '%[min]' info:) < OPACITY )); then
        "$CONVERT" -regard-warnings "$VERBOSE" "$1" "${resize_args[@]}" -quality 95 PNG:"$2"
    else
        "$CONVERT" -regard-warnings "$VERBOSE" "$1" "${resize_args[@]}" -quality "$QUALITY" JPEG:"$2"
    fi
}

function convert-godot-tex {
    cp -p -- "$1" "$2" || return 1
    "$PYTHON3" "$GODOT_HELPER" tex "$2" "$CONVERT" "$QUALITY" "$WMETHOD"
    local rc=$?
    if (( rc == 2 )); then
        return 0
    fi
    return $rc
}

function convert-godot-aud {
    cp -p -- "$1" "$2" || return 1
    "$PYTHON3" "$GODOT_HELPER" aud "$2" "$FFMPEG"
    local rc=$?
    if (( rc == 2 )); then
        return 0
    fi
    return $rc
}
export -f convert-parallax convert-image convert-jpgpng convert-godot-tex convert-godot-aud

function convert-audio {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -map_metadata -1 -codec:a libopus -vn -b:a 32k -compression_level 10 -vbr on -f ogg "$2" "${log_args[@]}"
}
function convert-mp3 {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -map_metadata -1 -codec:a libmp3lame -qscale:a 7 -vn -f mp3 "$2" "${log_args[@]}"
}
function convert-ogg {
    local -a log_args=()
    [ -n "$LOGLEVEL" ] && read -ra log_args <<< "$LOGLEVEL"
    "$FFMPEG" -y -i "$1" -codec:a libvorbis -qscale:a 3 -f ogg "$2" "${log_args[@]}"
}
export -f convert-audio convert-mp3 convert-ogg

function convert-webm {
    local PASSLOG
    PASSLOG="$(mktemp -p "$TMP_ROOT" "passlog.XXXXXX")"
    local -a vlog_args=()
    [ -n "$VLOGLEVEL" ] && read -ra vlog_args <<< "$VLOGLEVEL"

    local VF_ARGS="format=yuv420p"
    if [[ -n "$MAX_DIM" && "$MAX_DIM" -gt 0 ]]; then
        VF_ARGS="scale=-2:'min(${MAX_DIM},ih)',format=yuv420p"
    fi

    if $ACCEL; then
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good \
            -b:v 0 -crf 38 -speed 5 -tile-columns 2 -frame-parallel 1 -g 120 \
            -c:a libopus -vbr on -compression_level:a 10 -frame_duration 20 -application audio -b:a 32k \
            -f webm "$2" "${vlog_args[@]}"
    else
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good -pass 1 \
            -b:v 0 -crf 38 -speed 5 -tile-columns 2 -frame-parallel 1 -g 120 -an \
            -passlogfile "$PASSLOG" -f webm /dev/null "${vlog_args[@]}" && \
        "$FFMPEG" -y -i "$1" -vf "$VF_ARGS" \
            -c:v libvpx-vp9 -threads "$THREADS" -row-mt 1 -quality good -pass 2 \
            -b:v 0 -crf 38 -speed 3 -tile-columns 2 -frame-parallel 1 -auto-alt-ref 1 -lag-in-frames 16 -g 120 \
            -c:a libopus -vbr on -compression_level:a 10 -frame_duration 20 -application audio -b:a 32k \
            -passlogfile "$PASSLOG" -f webm "$2" "${vlog_args[@]}"
    fi
    local STATUS=$?
    rm -f "${PASSLOG}"*
    return $STATUS
}

function convert-ogv {
    local PASSLOG
    PASSLOG="$(mktemp -p "$TMP_ROOT" "passlog.XXXXXX")"
    local -a vlog_args=()
    [ -n "$VLOGLEVEL" ] && read -ra vlog_args <<< "$VLOGLEVEL"

    local -a vf_args=()
    if [[ -n "$MAX_DIM" && "$MAX_DIM" -gt 0 ]]; then
        vf_args=( -vf "scale=-2:'min(${MAX_DIM},ih)',format=yuv420p" )
    fi

    "$FFMPEG" -y -i "$1" "${vf_args[@]}" -c:v libtheora -threads "$THREADS" -pass 1 -g 240 -vsync 2 -an \
        -passlogfile "$PASSLOG" -f ogv /dev/null "${vlog_args[@]}" && \
    "$FFMPEG" -y -i "$1" "${vf_args[@]}" -c:v libtheora -threads "$THREADS" -pass 2 -g 240 -vsync 2 -c:a libvorbis -compression_level 10 \
        -passlogfile "$PASSLOG" -f ogv "$2" "${vlog_args[@]}"
    local STATUS=$?
    rm -f "${PASSLOG}"*
    return $STATUS
}
export -f convert-webm convert-ogv

function images {
    local EXT
    if [ "$MODE" = Ace ]; then
        for EXT in jpg jpeg png; do process image "$EXT" jpgpng; done
    elif [ "$MODE" = RPGM ]; then
        for EXT in webp jpg jpeg bmp png; do process image "$EXT"; done
    elif [ "$MODE" = Godot ]; then
        for EXT in webp jpg jpeg bmp png; do process image "$EXT"; done
        if [ -n "$PYTHON3" ] && [ -f "$GODOT_HELPER" ]; then
            for EXT in ctex stex; do process image "$EXT" godot-tex; done
        elif ! $PRETEND && ! $ERRORSONLY; then
            fit60 "  Note: godot-repack-helper.py missing (.ctex/.stex)"
            echo
        fi
    else
        for EXT in webp jpg jpeg bmp png gif; do process image "$EXT"; done
    fi
}

function audio {
    local EXT
    if [[ "$MODE" = @(RPGM|Ace) ]]; then
        process audio mp3 mp3
        process audio wav mp3
        process audio ogg ogg
    elif [ "$MODE" = Godot ]; then
        process audio wav ogg
        process audio ogg ogg
        if [ -n "$PYTHON3" ] && [ -f "$GODOT_HELPER" ]; then
            for EXT in oggstr oggvorbisstr; do process audio "$EXT" godot-aud; done
        elif ! $PRETEND && ! $ERRORSONLY; then
            fit60 "  Note: godot-repack-helper.py missing (.oggstr)"
            echo
        fi
    else
        for EXT in mp3 wav ogg opus; do process audio "$EXT"; done
    fi
}

function video {
    local FMT EXT
    [[ "$MODE" = @(Ace|Godot) ]] && FMT=ogv || FMT=webm
    for EXT in webm mp4 mkv m4v mpg mov ogv avi; do process video "$EXT" "$FMT"; done
}

function show-time {
    local N="$1"
    if (( N < 60 )); then
        echo "${N}s"
    else
        printf '%dm%02ds\n' $(( N / 60 )) $(( N % 60 ))
    fi
}

function show-progress {
    local CURRENT="$1" TOTAL="$2" EXT="$3" EXTRA="${*:4}"
    local PERCENT=0 BAR_W=20 FILLED=0
    (( TOTAL > 0 )) && PERCENT=$(( CURRENT * 100 / TOTAL ))
    FILLED=$(( PERCENT * BAR_W / 100 ))
    local BAR=""
    (( FILLED > 0 )) && printf -v BAR "%${FILLED}s" "" && BAR="${BAR// /#}"
    local PAD=""
    (( BAR_W - FILLED > 0 )) && printf -v PAD "%$(( BAR_W - FILLED ))s" "" && PAD="${PAD// /.}"

    set-term-title "$NAME: ${EXT^^} $CURRENT/$TOTAL (${PERCENT}%) $EXTRA {$GAME}"
    printf "\r%-8s [%s%s] %3d%% (%d/%d) %-10s" "${EXT:0:8}" "$BAR" "$PAD" "$PERCENT" "$CURRENT" "$TOTAL" "${EXTRA:0:10}" >&2
    (( CURRENT == TOTAL && TOTAL > 0 )) && echo >&2
}

function apply-conversion {
    local TYPE="$1"
    local EXT="$2"
    local FILE="$3"
    local CONV_TYPE="$4"
    local _VERBOSE=""

    if [[ ( "$TYPE" = video && "$VPARALLEL" != true && "$ACCEL" != true ) || "$VERBOSE" = '-verbose' ]]; then
        _VERBOSE='--verbose'
    fi

    [ -n "$_VERBOSE" ] && printf "%s\n" "$(fit60-path "Processing: $FILE" 60)" >&2

    local ORIG_PERMS
    ORIG_PERMS=$(stat -c '%a' -- "$FILE")
    chmod +w -- "$FILE"

    if [ "$MODE" = RenPy ] && [ "$EXT" = webp ]; then
        webp-header-fix "$FILE"
        [ -n "$_VERBOSE" ] && echo "  WebP header rewritten." >&2
    fi

    local BUFFER
    BUFFER="$(mktemp -p "$TMP_ROOT" "buf.XXXXXX")"
    chmod "$ORIG_PERMS" -- "$BUFFER"

    if [ "$MODE" = RPGM ] && [[ "${FILE,,}" = img/parallaxes/* ]]; then
        convert-parallax "$FILE" "$BUFFER"
    else
        convert-"$CONV_TYPE" "$FILE" "$BUFFER"
    fi

    local CONV_STATUS=$?
    if (( CONV_STATUS != 0 )); then
        printf "%s\n" "$(fit60-path "! ERROR: Failed $FILE" 60)" >&2
    elif [ ! -s "$BUFFER" ]; then
        printf "%s\n" "$(fit60-path "! ERROR: 0-byte output $FILE" 60)" >&2
    elif (( $(filesize "$BUFFER") >= $(filesize "$FILE") )); then
        [ -n "$_VERBOSE" ] && printf "%s\n" "$(fit60-path "  SKIP: Larger $FILE" 60)" >&2
    else
        touch -r "$FILE" "$BUFFER"
        mv ${_VERBOSE:+"$_VERBOSE"} -- "$BUFFER" "$FILE" >&2
    fi

    chmod "$ORIG_PERMS" -- "$FILE" 2>/dev/null
    rm -f "$BUFFER"

    if [ -n "$DONE" ]; then
        echo -n . >> "$DONE"
        local COUNTER PERCENT=0
        COUNTER=$(filesize "$DONE")
        (( TOTAL > 0 )) && PERCENT=$(( COUNTER * 100 / TOTAL ))
        set-term-title "$NAME: ${EXT^^} $COUNTER/$TOTAL (${PERCENT}%) {$GAME}"
        echo -e "# ${EXT^^}: $COUNTER/$TOTAL\n$PERCENT"
    fi
}
export -f apply-conversion set-term-title fit60-path

function process {
    local TYPE="$1"
    local EXT="$2"
    local CONV_TYPE="${3:-$TYPE}"

    pushd "$GAMEDIR" >/dev/null || return
    local -a FILES=()
    mapfile -d '' FILES < <(find . -type f -iname "*.$EXT" -printf '%P\0')
    local TOTAL=${#FILES[@]}

    ! $PRETEND && echo -e "# ${EXT^^}: 0/$TOTAL\n0"

    if (( TOTAL <= 0 )); then
        $PRETEND || $ERRORSONLY || echo "  No .$EXT ($TYPE) files found." >&2
    else
        if ! $PRETEND; then
            $ERRORSONLY || echo "  Found $TOTAL .$EXT ($TYPE) files..." >&2
            local START=$SECONDS
            set-term-title "$NAME: ${EXT^^} | $TOTAL $TYPE files {$GAME}"

            if [ -n "$PARALLEL_" ] && { [ "$TYPE" != video ] || $VPARALLEL; }; then
                export GAMEDIR MODE CONVERT FFMPEG PYTHON3 GODOT_HELPER VAAPI_DEVICE FPSMODE QUALITY WMETHOD OPACITY MAX_DIM THREADS LOGLEVEL VLOGLEVEL ACCEL VERBOSE VPARALLEL TMP_ROOT
                export GAME NAME TOTAL START AV_LOG_FORCE_COLOR=yes
                DONE="$(mktemp -p "$TMP_ROOT" "done-$EXT.XXXXXX")"
                export DONE

                printf '%s\0' "${FILES[@]}" | "$PARALLEL_" -0 --bar apply-conversion "$TYPE" "$EXT" {} "$CONV_TYPE"
                rm -f "$DONE"
                unset DONE
            else
                local COUNTER=0 FILE ELAPSED ETA
                show-progress "$COUNTER" "$TOTAL" "$EXT"
                for FILE in "${FILES[@]}"; do
                    (( COUNTER++ ))
                    apply-conversion "$TYPE" "$EXT" "$FILE" "$CONV_TYPE"
                    ELAPSED=$(( SECONDS - START ))
                    ETA=0
                    (( COUNTER > 0 )) && ETA=$(( ELAPSED * (TOTAL - COUNTER) / COUNTER ))
                    show-progress "$COUNTER" "$TOTAL" "$EXT" "ETA $(show-time "$ETA")"
                done
            fi

            local DURATION=$(( SECONDS - START ))
            TOTAL_TIME=$(( TOTAL_TIME + DURATION ))
            echo "  Done: $TOTAL .$EXT files in $(show-time "$DURATION")." >&2
        fi
        COUNT[$EXT]="$TOTAL"
    fi

    popd >/dev/null || return
}

function count {
    printf "%-4s: %4d" "$1" "${COUNT[$1]:-0}"
}

function report {
    $PRETEND || set-term-title "$NAME: Finished {$GAME}"
    echo
    echo "$HR"
    if $PRETEND; then
        echo "  Scan Summary (Dry Run)"
    else
        echo "  Compression Summary (Time: $(show-time "$TOTAL_TIME"))"
    fi
    echo "$HR"

    if [[ " $* " =~ " image " ]]; then
        printf "  [Images] %s | %s | %s\n" "$(count webp)" "$(count jpg)" "$(count jpeg)"
        printf "           %s | %s | %s\n" "$(count bmp)"  "$(count png)" "$(count gif)"
        if [ "$MODE" = Godot ]; then
            printf "           %s | %s\n" "$(count ctex)" "$(count stex)"
        fi
    fi
    if [[ " $* " =~ " audio " ]]; then
        printf "  [Audio]  %s | %s | %s | %s\n" "$(count mp3)" "$(count ogg)" "$(count opus)" "$(count wav)"
        if [ "$MODE" = Godot ]; then
            printf "           %-6s: %4d | %-12s: %4d\n" "oggstr" "${COUNT[oggstr]:-0}" "oggvorbisstr" "${COUNT[oggvorbisstr]:-0}"
        fi
    fi
    if [[ " $* " =~ " video " ]]; then
        printf "  [Video]  %s | %s | %s | %s\n" "$(count webm)" "$(count mp4)" "$(count mkv)" "$(count m4v)"
        printf "           %s | %s | %s | %s\n" "$(count mpg)"  "$(count mov)" "$(count ogv)" "$(count avi)"
    fi
    echo "$HR"

    if $PRETEND; then
        return 1
    else
        read -r -p "Enter '1' for menu, any other key to exit: "
        echo "$HR"
        [[ "$REPLY" = 1 ]]
        return $?
    fi
}

function grep+ {
    [ -n "$2" ] && [ "$2" != / ] && grep --colour -oEH "$1" "${@:3}" "$2"
}

function extra-info {
    if [ "$MODE" = RPGM ]; then
        echo "  RPGM Encryption Key:"
        grep+ '"encryptionKey":\s*"[^"]*"' "$(locate "$GAMEDIR/data/System.json")"
        grep+ '[_[:alnum:]]+\._encryptionKey\s*=[^;]*;?' "$(locate "$GAMEDIR/js")/" -R
    elif [ "$MODE" = Godot ]; then
        local pcks=( "$GAMEDIR"/*.pck )
        local emb
        emb=$(cd "$GAMEDIR" && has-embedded-pck)
        if (( ${#pcks[@]} > 0 )) || [ -n "$emb" ]; then
            echo "  Godot Archives:"
            local f
            for f in "${pcks[@]}"; do
                [ -f "$f" ] && printf "    %s\n" "$(fit60-path "$(basename "$f")" 56)"
            done
            [ -n "$emb" ] && printf "    %s (embedded)\n" "$(fit60-path "${emb#./}" 45)"
        fi
    fi
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
    parse-args "$@"
    while :; do
        init
        PRETEND=true images
        PRETEND=true audio
        PRETEND=true video
        PRETEND=true report image audio video
        extra-info
        ! $PRETEND && menu || break
    done
fi
$PRETEND || set-term-title "${PWD##*/}"
